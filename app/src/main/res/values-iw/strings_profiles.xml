    <string name="profile_gentle_off">פרופיל עדין: כבוי</string>
    <string name="profile_gentle_what">פרופיל עדין מציג תמיד רק את הסרטים העדינים ביותר, כמו ערב משפחתי, ולא מציג קבצים אישיים.</string>
    <string name="profile_gentle_no_pin">לא הוגדר PIN, ולכן כל אחד יכול לצאת מהפרופיל הזה. הגדירו PIN בהגדרות כדי לנעול אותו.</string>
