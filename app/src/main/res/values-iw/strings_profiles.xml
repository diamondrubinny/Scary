<resources>
    <string name="profiles_title">מי צופה?</string>
    <string name="profiles_note">לכל צופה יש רשימה משלו, סרטים שנצפו, דירוגים, Bucket list והמשך צפייה. פרופילים הם נוחות ולא נעילה: כל מי שליד הטלוויזיה יכול לפתוח כל פרופיל, חוץ מיציאה מפרופיל עדין, שדורשת PIN. חשבונות TMDB ו-Stremio מסתנכרנים רק עם הפרופיל הראשון. השמות נשארים בטלוויזיה הזו.</string>
    <string name="profiles_add">הוספת פרופיל</string>
    <string name="profiles_hint">החזיקו OK על פרופיל כדי לשנות את שמו, לערוך אותו או להסיר אותו.</string>
    <string name="profiles_switch">פרופיל: %1$s. החלפת פרופיל</string>
