<?xml version="1.0" encoding="utf-8"?>
<!-- Powered by SCARY · Open source · https://github.com/diamondrubinny/Scary (Apache-2.0, see NOTICE). -->
<!--
    Android 12 and later: nothing of SCARY's leaves the TV through cloud backup or device-to-device transfer
    (settings, PIN hash, the encrypted TMDB key, caches). Same as allowBackup="false" on older versions; see
    docs/PRIVACY.md.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
