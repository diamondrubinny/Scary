<!-- Android 11 and earlier: nothing is backed up (allowBackup is also false). Android 12+: data_extraction_rules. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
